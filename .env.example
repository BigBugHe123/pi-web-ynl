# Copy to .env and replace with a long, unique secret before starting Pi Web.
PI_WEB_PASSWORD=change-this-to-a-long-random-password

# Host-side port. Pi Web listens on 30141 inside the container.
PI_WEB_PORT=30141

# Optional: comma-separated exact hostnames forwarded by a reverse proxy.
PI_WEB_ALLOWED_HOSTS=

# Rust YLL agent backend. Start it separately and configure the same
# PI_WEB_PASSWORD in that process. Docker Compose reaches the host backend here.
PI_RUST_BACKEND_URL=http://host.docker.internal:3030
# Optional override for Open in Explorer. Set 1 only when Rust can open the
# desktop file manager on the same computer as the browser; remote URLs default off.
# PI_RUST_BACKEND_SAME_HOST=1
